# Copy to `.env` (which is git-ignored) and fill in real values.
# docker compose reads this automatically.

# ---- PostgreSQL ----
POSTGRES_DB=bank_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ---- Application secrets (override appsettings.json) ----
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Optional ----
# DB_BIND=127.0.0.1        # host interface for the published DB port (if enabled)
# API_BIND=127.0.0.1       # host interface for the API port
